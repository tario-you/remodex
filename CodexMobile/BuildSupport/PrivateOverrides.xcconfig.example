// Copy this file to PrivateOverrides.xcconfig and keep the real values local.
// Xcode will load the private file automatically when it exists.

// Set to YES for a local self-host build that skips RevenueCat and the Pro gate.
REMODEX_SELF_HOST_BUILD = NO

// Optional: point local self-host builds at a minimal entitlements file.
REMODEX_CODE_SIGN_ENTITLEMENTS = CodexMobile/CodexMobile.entitlements

// Optional: prefill a relay URL instead of pasting or scanning one at runtime.
PHODEX_DEFAULT_RELAY_URL =
